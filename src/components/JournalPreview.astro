---
import ArticleCard from './ArticleCard.astro';
import { getPublishedEntries } from '../lib/journal';
import { home } from '../data/home';
import { withBase } from '../lib/paths';

const entries = (await getPublishedEntries()).slice(0, 2);
---

<section class="section container" id="journal" aria-labelledby="journal-heading">
  <div class="section-heading">
    <div><p class="eyebrow">{home.journal.eyebrow}</p><h2 id="journal-heading">{home.journal.heading}</h2><p>{home.journal.description}</p></div>
    <a class="text-link" href={withBase('journal/')}>View the journal <span aria-hidden="true">↗</span></a>
  </div>
  {entries.length > 0 ? <div class="article-grid">{entries.map((entry, index) => <ArticleCard entry={entry} index={index} />)}</div> : <p class="empty-state">The first stories are taking shape. Check back soon.</p>}
</section>
