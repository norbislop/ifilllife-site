---
import { home } from '../data/home';
import { withBase } from '../lib/paths';
---

<section class="container hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{home.hero.eyebrow}</p>
    <h1 id="hero-heading">{home.hero.heading}<br /><em>{home.hero.emphasis}</em></h1>
    <p class="hero-description">{home.hero.description}</p>
    <div class="hero-actions">
      <a class="button" href={withBase('journal/')}>{home.hero.primaryLabel}<span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#about">{home.hero.secondaryLabel}<span aria-hidden="true">↓</span></a>
    </div>
    <p class="hero-note">{home.hero.note}</p>
  </div>
  <aside class="hero-art" aria-label="A little clarity goes a long way">
    <div class="art-top"><span>The iFillLife idea</span><span aria-hidden="true">✳</span></div>
    <svg class="growth-mark" viewBox="0 0 280 220" fill="none" aria-hidden="true">
      <path d="M140 195V96" stroke="currentColor" stroke-width="3" />
      <path d="M140 152C77 152 53 117 53 77c51 0 87 24 87 75Z" fill="#234839" />
      <path d="M140 117c0-58 32-90 85-90 0 54-32 90-85 90Z" fill="#8b9d64" />
      <path d="M140 178c0-40 25-61 64-61 0 38-24 61-64 61Z" fill="#cfad57" />
      <path d="M93 195h94" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      <circle cx="75" cy="32" r="13" stroke="currentColor" stroke-width="1.5" />
      <path d="M229 167v21m-10-10h20" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <p>A little clarity<br />goes a <em>long way.</em></p>
    <div class="art-bottom"><span>Less overwhelm.<br />More perspective.</span><span aria-hidden="true">↗</span></div>
  </aside>
</section>
