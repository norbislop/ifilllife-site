---
import { services } from '../data/services';
import { withBase } from '../lib/paths';

function serviceUrl(href: string) {
  if (href.startsWith('/') && !href.startsWith('//')) return withBase(href);
  if (href.startsWith('https://')) return href;
  throw new Error('Service links must start with / or https://');
}
---

{services.length > 0 && (
  <section class="section section-topics" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Work with iFillLife</p><h2 id="services-heading">How we can help.</h2></div></div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <h3>{service.title}</h3><p>{service.description}</p>
            <a class="text-link" href={serviceUrl(service.href)}>{service.linkLabel}<span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
