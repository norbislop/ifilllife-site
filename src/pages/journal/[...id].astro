---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../lib/journal';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  return (await getPublishedEntries()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'journal'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | iFillLife`} description={entry.data.description} type="article">
  <article class="container reading-page">
    <a class="text-link" href={withBase('journal/')}><span aria-hidden="true">←</span> Back to the journal</a>
    <header class="article-heading"><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p></header>
    <div class="prose"><Content /></div>
    <div class="article-end"><span aria-hidden="true">✳</span><p>One thought. One next step.</p><a class="text-link" href={withBase('journal/')}>Keep exploring <span aria-hidden="true">→</span></a></div>
  </article>
</BaseLayout>
