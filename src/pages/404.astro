---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Page not found | iFillLife" description="Let's find your way back to iFillLife." noindex>
  <section class="container page-intro not-found">
    <p class="eyebrow">404 · A small detour</p>
    <h1>Let’s find your<br /><em>way back.</em></h1>
    <p>This page may have moved, or the address may be a little off.</p>
    <a class="button" href={withBase()}>Back to iFillLife <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
